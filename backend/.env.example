# Copy to .env and fill in for production use. The app runs fine without this file for local dev.

# JWT signing key — set a real random string in production
SECRET_KEY=dev-secret-change-me-in-production

# SMTP settings for the admin "Broadcast Email" feature. Leave unset to disable sending
# (the endpoint will still respond, just with configured=false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
